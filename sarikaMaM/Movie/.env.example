# .env.example - Example Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT COMMIT the actual .env file to version control

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# MongoDB Connection URI
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/movie_db

# For MongoDB Atlas (Cloud):
# Go to https://www.mongodb.com/cloud/atlas
# Create a cluster
# Click "Connect" → "Drivers"
# Copy the connection string and replace username/password
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/movie_db?retryWrites=true&w=majority

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Server Port (default 3000)
PORT=3000

# ============================================================
# SESSION CONFIGURATION
# ============================================================

# Secret key for signing session cookies
# IMPORTANT: Change this to a random string in production
# You can generate one with: require('crypto').randomBytes(32).toString('hex')
SESSION_SECRET=your_super_secret_key_change_this_in_production_to_something_random_and_long

# ============================================================
# NODE ENVIRONMENT
# ============================================================

# Set to 'development' for local testing, 'production' for live
NODE_ENV=development

# ============================================================
# CORS CONFIGURATION
# ============================================================

# Allowed origins for CORS (comma-separated)
# For development: * (all origins)
# For production: specify your domain
CORS_ORIGIN=*

# ============================================================
# LOGGING
# ============================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info
