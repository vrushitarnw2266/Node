<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Todo</title>
    <style>
        <%- include('style.css') %>
    </style>
</head>

<body>
    <h2>Edit Todo</h2>
    <form action="/<%= todo._id %>" method="POST" enctype="multipart/form-data">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="<%= todo.name %>" required>
        <br>
        <label for="description">Description:</label>
        <textarea id="description" name="description"><%= todo.description %></textarea>
        <br>
        <label for="image">Image (leave empty to keep current):</label>
        <input type="file" id="image" name="image" accept="image/*">
        <% if (todo.image) { %>
            <br><img src="/uploads/<%= todo.image %>" alt="Current Image" style="max-width: 200px;">
            <% } %>
                <br>
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" value="<%= todo.email %>" required>
                <br>


                <button type="submit">Update Todo</button>
    </form>
    <a href="/">Back to List</a>
</body>

</html>