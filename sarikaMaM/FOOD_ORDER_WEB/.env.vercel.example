# Copy these into Vercel → Settings → Environment Variables
# (Do NOT commit real secrets to Git)

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/my_vaggie_?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=https://your-project-name.vercel.app

# Do NOT set VITE_API_URL on Vercel — frontend uses same-origin /api
