<%- include('partials/header') %>

<!-- Contact Hero -->
<section class="relative py-24 bg-[linear-gradient(rgba(0,0,0,0.70),rgba(0,0,0,0.80)),url('https://images.unsplash.com/photo-1552566626-52f8b828add9?ixlib=rb-1.2.1&auto=format&fit=crop&w=1600&q=80')] bg-cover bg-center">
    <div class="max-w-7xl mx-auto px-5 text-center">
        <span class="inline-block px-5 py-2 mb-5 rounded-full bg-yellow-400/15 text-yellow-400 text-sm font-semibold uppercase tracking-wider">
            Contact Us
        </span>

        <h1 class="text-4xl md:text-6xl font-bold text-white mb-5">
            Get In Touch With Savor
        </h1>

        <p class="max-w-2xl mx-auto text-gray-300 text-lg leading-relaxed">
            Have a question, feedback, or special request? We’d love to hear from you.
        </p>
    </div>
</section>

<!-- Contact Section -->
<section class="py-20 bg-[#111111]">
    <div class="max-w-7xl mx-auto px-5">
        <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-12 items-start">

            <!-- Contact Info -->
            <div>
                <span class="inline-block px-5 py-2 mb-5 rounded-full bg-yellow-400/15 text-yellow-400 text-sm font-semibold uppercase tracking-wider">
                    Reach Us
                </span>

                <h2 class="text-3xl md:text-4xl font-bold text-white mb-5">
                    Let’s Talk About Food
                </h2>

                <p class="text-gray-300 leading-relaxed mb-8">
                    Whether you want to ask about our menu, place a special order,
                    share feedback, or know more about Savor, our team is always ready to help you.
                </p>

                <div class="space-y-5">
                    <div class="flex gap-5 p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-yellow-400/50 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300">
                        <div class="w-12 h-12 min-w-12 rounded-full bg-yellow-400/15 flex items-center justify-center text-2xl">
                            📍
                        </div>
                        <div>
                            <h3 class="text-white text-lg font-semibold mb-1">Our Location</h3>
                            <p class="text-gray-300">Ahmedabad, Gujarat, India</p>
                        </div>
                    </div>

                    <div class="flex gap-5 p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-yellow-400/50 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300">
                        <div class="w-12 h-12 min-w-12 rounded-full bg-yellow-400/15 flex items-center justify-center text-2xl">
                            📞
                        </div>
                        <div>
                            <h3 class="text-white text-lg font-semibold mb-1">Phone Number</h3>
                            <p class="text-gray-300">+91 98765 43210</p>
                        </div>
                    </div>

                    <div class="flex gap-5 p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-yellow-400/50 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300">
                        <div class="w-12 h-12 min-w-12 rounded-full bg-yellow-400/15 flex items-center justify-center text-2xl">
                            ✉️
                        </div>
                        <div>
                            <h3 class="text-white text-lg font-semibold mb-1">Email Address</h3>
                            <p class="text-gray-300">support@savor.com</p>
                        </div>
                    </div>

                    <div class="flex gap-5 p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-yellow-400/50 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300">
                        <div class="w-12 h-12 min-w-12 rounded-full bg-yellow-400/15 flex items-center justify-center text-2xl">
                            ⏰
                        </div>
                        <div>
                            <h3 class="text-white text-lg font-semibold mb-1">Opening Hours</h3>
                            <p class="text-gray-300">Mon - Sun: 10:00 AM - 11:00 PM</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="p-6 md:p-9 rounded-3xl bg-white/5 border border-white/10 shadow-2xl">
                <form onsubmit="handleContactForm(event)">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="mb-5">
                            <label class="block text-white font-semibold mb-2">Your Name</label>
                            <input 
                                type="text" 
                                placeholder="Enter your name" 
                                required
                                class="w-full px-4 py-4 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-gray-400 outline-none focus:border-yellow-400 focus:ring-4 focus:ring-yellow-400/10 transition-all duration-300"
                            >
                        </div>

                        <div class="mb-5">
                            <label class="block text-white font-semibold mb-2">Your Email</label>
                            <input 
                                type="email" 
                                placeholder="Enter your email" 
                                required
                                class="w-full px-4 py-4 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-gray-400 outline-none focus:border-yellow-400 focus:ring-4 focus:ring-yellow-400/10 transition-all duration-300"
                            >
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="block text-white font-semibold mb-2">Phone Number</label>
                        <input 
                            type="tel" 
                            placeholder="Enter your phone number" 
                            required
                            class="w-full px-4 py-4 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-gray-400 outline-none focus:border-yellow-400 focus:ring-4 focus:ring-yellow-400/10 transition-all duration-300"
                        >
                    </div>

                    <div class="mb-5">
                        <label class="block text-white font-semibold mb-2">Subject</label>
                        <select 
                            required
                            class="w-full px-4 py-4 rounded-2xl bg-white/10 border border-white/10 text-white outline-none focus:border-yellow-400 focus:ring-4 focus:ring-yellow-400/10 transition-all duration-300"
                        >
                            <option value="" class="text-black">Select subject</option>
                            <option value="order" class="text-black">Order Related</option>
                            <option value="feedback" class="text-black">Feedback</option>
                            <option value="reservation" class="text-black">Table Reservation</option>
                            <option value="support" class="text-black">Customer Support</option>
                        </select>
                    </div>

                    <div class="mb-6">
                        <label class="block text-white font-semibold mb-2">Your Message</label>
                        <textarea 
                            rows="5" 
                            placeholder="How can we help you?" 
                            required
                            class="w-full px-4 py-4 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-gray-400 outline-none resize-none focus:border-yellow-400 focus:ring-4 focus:ring-yellow-400/10 transition-all duration-300"
                        ></textarea>
                    </div>

                    <button 
                        type="submit"
                        class="w-full px-7 py-4 rounded-full bg-yellow-400 text-black font-bold hover:bg-yellow-500 hover:-translate-y-1 hover:shadow-[0_15px_35px_rgba(250,204,21,0.25)] transition-all duration-300"
                    >
                        Send Message
                    </button>
                </form>
            </div>

        </div>
    </div>
</section>

<!-- Map Section -->
<section class="py-20 bg-[#151515]">
    <div class="max-w-7xl mx-auto px-5">
        <div class="max-w-3xl mx-auto text-center mb-12">
            <span class="inline-block px-5 py-2 mb-5 rounded-full bg-yellow-400/15 text-yellow-400 text-sm font-semibold uppercase tracking-wider">
                Find Us
            </span>

            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                Visit Our Restaurant
            </h2>

            <p class="text-gray-300 leading-relaxed">
                We are located in the heart of Ahmedabad. Come and enjoy fresh vegetarian food with us.
            </p>
        </div>

        <div class="overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
            <iframe
                src="https://www.google.com/maps?q=Ahmedabad%20Gujarat%20India&output=embed"
                width="100%"
                height="380"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                class="block grayscale invert-[90%]"
            ></iframe>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="py-20 bg-[#111111]">
    <div class="max-w-7xl mx-auto px-5">
        <div class="text-center py-16 px-6 rounded-[30px] bg-[linear-gradient(rgba(0,0,0,0.65),rgba(0,0,0,0.75)),url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?ixlib=rb-1.2.1&auto=format&fit=crop&w=1400&q=80')] bg-cover bg-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                Hungry? Let’s Make Your Day Delicious!
            </h2>

            <p class="text-gray-300 mb-7">
                Explore our menu and enjoy fresh vegetarian food made with love.
            </p>

            <a 
                href="/menu"
                class="inline-block px-8 py-4 rounded-full bg-yellow-400 text-black font-bold hover:bg-yellow-500 hover:-translate-y-1 hover:shadow-[0_15px_35px_rgba(250,204,21,0.25)] transition-all duration-300"
            >
                Explore Menu
            </a>
        </div>
    </div>
</section>

<script>
    function handleContactForm(event) {
        event.preventDefault();
        alert("Thank you! Your message has been sent successfully.");
        event.target.reset();
    }
</script>

<%- include('partials/footer') %>