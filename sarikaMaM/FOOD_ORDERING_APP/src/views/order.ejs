<%- include('partials/header') %>

<section class="page-header">
    <h1>Order Food</h1>
    <p>Craving something? We'll deliver it fast.</p>
</section>

<section class="content-section">
    <div class="layout-grid">
        <div class="form-container">
            <h3>Place a New Order</h3>
            <% if (error) { %> <div class="alert alert-error"><%= error %></div> <% } %>
            <% if (success) { %> <div class="alert alert-success"><%= success %></div> <% } %>
            
            <form action="/order" method="POST" class="custom-form">
                <div class="form-group">
                    <label>Select Food Item</label>
                    <select name="foodItem" required>
                        <option value="Gourmet Pizza">Gourmet Pizza - $15</option>
                        <option value="Craft Burger">Craft Burger - $12</option>
                        <option value="Sushi Platter">Sushi Platter - $25</option>
                        <option value="Pasta Carbonara">Pasta Carbonara - $14</option>
                        <option value="Caesar Salad">Caesar Salad - $10</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Quantity</label>
                    <input type="number" name="quantity" min="1" value="1" required>
                </div>
                <div class="form-group">
                    <label>Special Instructions</label>
                    <textarea name="specialInstructions" rows="3" placeholder="Any allergies or requests?"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-block">Place Order</button>
            </form>
        </div>

        <div class="history-container">
            <h3>Your Recent Orders</h3>
            <% if (orders && orders.length > 0) { %>
                <ul class="item-list">
                    <% orders.forEach(order => { %>
                        <li class="item-card">
                            <div class="item-info">
                                <strong><%= order.quantity %>x <%= order.foodItem %></strong>
                                <span>Status: <span class="badge <%= order.status.toLowerCase() %>"><%= order.status %></span></span>
                            </div>
                            <small class="text-muted"><%= new Date(order.createdAt).toLocaleDateString() %></small>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>You haven't placed any orders yet.</p>
            <% } %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
