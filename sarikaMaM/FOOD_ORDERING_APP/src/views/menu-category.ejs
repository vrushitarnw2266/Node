<%- include('partials/header') %>

<section class="page-header">
    <div class="container">
        <h1><%= category %> Varieties</h1>
        <p>Choose your favorite vegetarian <%= category.toLowerCase() %> from our curated list.</p>
        <a href="/" class="btn btn-outline" style="margin-top: 1rem;">← Back to Home</a>
    </div>
</section>

<section class="content-section">
    <div class="card-grid">
        <% items.forEach(item => { %>
            <div class="card">
                <div class="card-icon"><%= item.icon %></div>
                <h3><%= item.name %></h3>
                <p><%= item.description %></p>
                <div class="item-footer" style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
                    <span class="price" style="font-size: 1.25rem; font-weight: 700; color: var(--primary-color);">₹<%= item.price %></span>
                    <a href="/order" class="btn btn-primary btn-sm">Order Now</a>
                </div>
            </div>
        <% }); %>
    </div>
</section>

<%- include('partials/footer') %>
