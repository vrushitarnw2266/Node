<%- include("../partials/header") %>

<section class="hero">
  <div>
    <p class="eyebrow">MongoDB + Express + MVC</p>
    <h1>Book Store Dashboard</h1>
    <p class="hero-text">
      Manage your collection of books with a clean MVC project structure.
    </p>
  </div>
  <a href="/books/create" class="button">Add New Book</a>
</section>

<section class="card">
  <% if (books.length === 0) { %>
    <div class="empty-state">
      <h2>No books added yet</h2>
      <p>Start by adding your first book to the store.</p>
    </div>
  <% } else { %>
    <div class="grid">
      <% books.forEach((book) => { %>
        <article class="book-card">
          <div class="book-card-top">
            <span class="badge"><%= book.genre %></span>
            <span class="<%= book.inStock ? 'stock in' : 'stock out' %>">
              <%= book.inStock ? "In Stock" : "Out of Stock" %>
            </span>
          </div>
          <h2><%= book.title %></h2>
          <p class="author">by <%= book.author %></p>
          <p class="description"><%= book.description || "No description provided." %></p>
          <ul class="meta">
            <li>Price: Rs. <%= book.price %></li>
            <li>Published: <%= book.publishedYear || "N/A" %></li>
          </ul>
          <div class="actions">
            <a href="/books/<%= book._id %>/edit" class="button secondary">Edit</a>
            <form action="/books/<%= book._id %>/delete" method="POST">
              <button type="submit" class="button danger">Delete</button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include("../partials/footer") %>
