<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - TaskMaster</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="auth-wrapper">
    <div class="auth-card">
      <h2>Create Account</h2>
      <p>Sign up to start organizing tasks</p>

      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" class="form-control" placeholder="Enter username (min 3 chars)" required autofocus>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" class="form-control" placeholder="Enter password (min 6 chars)" required>
        </div>

        <div class="form-group">
          <label for="role">Register As</label>
          <select id="role" name="role" class="form-control">
            <option value="user">Regular User</option>
            <option value="admin">Administrator</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Register</button>
      </form>

      <div class="auth-footer">
        Already have an account? <a href="/login">Log In</a>
      </div>
    </div>
  </div>
</body>
</html>
